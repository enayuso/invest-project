# 환경변수 템플릿 — 이 파일(.env.example)은 값이 비어 있는 상태로 커밋됨.
# 실제 값은 .env.local(로컬, bare `uv run`) 또는 .env.dev(배포, pipeline.sh)에
# 채우며 두 파일 모두 gitignore 대상임. 여기에 실제 값을 넣지 말 것.
# app/config.py의 model_config(env_file) 참고.
#
# 이 파일이 형식의 정본이다 — .env.local/.env.dev는 같은 절 순서와 같은 키
# 구성을 따르고, 설명은 여기를 가리킨다(2026-08-31 통일).

# === LLM 백엔드 ===
# LLM_PROVIDER: "vllm"(기본, 자체호스팅) 또는 "gateway".
#   vllm    → LLM_BASE_URL + LLM_MODEL. 키 불필요.
#   gateway → OpenAI 호환 프록시(레퍼런스: OmniRoute, 로컬 실행). LLM_API_KEY 필수.
#             LLM_GATEWAY_BASE_URL로 접속, LLM_MODEL에 게이트웨이의 모델/combo/전략명.
#             자체호스팅 경로는 코드에 그대로 남아있음 — 이 값만 되돌리면 복귀.
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4

# --- gateway 전용 (LLM_PROVIDER=gateway 일 때만) ---
# 게이트웨이 자체 엔드포인트 키 (OmniRoute: Dashboard → Endpoints → Create API key).
# 업스트림 제공자 키는 게이트웨이 설정에 있음, 여기 아님. 커밋 금지.
LLM_API_KEY=
# ⚠️ 경로 불일치 주의(2026-08-31 확인): app/config.py의 기본값은 `/v1`인데
# 실제 PoC를 돌린 .env.local은 `/api/v1`을 쓰고 있음. OmniRoute 배포본에 따라
# 다를 수 있으니, gateway로 전환할 때 `curl <이 URL>/models`로 먼저 확인할 것.
LLM_GATEWAY_BASE_URL=http://localhost:20128/v1
# reasoning=True 호출의 사고 강도(low/medium/high). reasoning=False 호출엔 아무것도 안 보냄
# (게이트웨이 thinking-budget 설정 + 클라이언트 재시도가 처리). low = PoC 지연/토큰 절약.
LLM_GATEWAY_REASONING_EFFORT=low

# 동시 LLM 요청 상한. 코드 기본값은 8이지만 이 배포에서는 2로 낮춰 쓴다 —
# 2026-08-12에 4로 올렸다가 서버(ops-s004)가 지속 고부하 후 반복 다운되는 사고가
# 나서 같은 날 되돌린 값(app/config.py의 llm_max_concurrent_requests 주석 참고).
# ⚠️ 하드웨어 원인(전원/냉각)이 규명되기 전까지 2 이상으로 올리지 말 것.
LLM_MAX_CONCURRENT_REQUESTS=2

# === AI 판단/디베이트 설정 ===
# 디베이트 라운드 상한(스펙: 2라운드 이하, 수렴 시 조기 종료)
MAX_DEBATE_ROUNDS=2
MAX_RISK_ROUNDS=2
# AI 판단 성향(production/test_aggressive/debug) — app/config.py의 AIProfile 참고.
# ⚠️ real 계좌에서는 production 이외 값이면 부팅이 거부됨(app/config.py:1554-1569).
AI_PROFILE=production
DEFAULT_TICKER=AAPL

# === 거시 데이터 ===
# 선택사항. 매크로 데이터(News+Macro 애널리스트)는 없어도 조용히 비활성화됨.
# 무료 키 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# === DB / 메모리(판단이력) ===
# 전용 Postgres+pgvector 인스턴스(Phase 3 메모리 + Phase 4 실행원장) — 다른
# 다른 프로덕션 호스트와 완전히 분리된 별도 물리서버(프로젝트 격리 요구사항).
# ipTIME 공유기 포트포워딩 — 컨테이너 내부 5434, 외부 45434.
# 형식: postgresql://USER:PASSWORD@HOST:PORT/trading_memory — 비워두면 이제 부팅이 거부됨.
DATABASE_URL=
MEMORY_N_SAME=5
MEMORY_N_CROSS=3
MEMORY_MIN_HOLDING_DAYS=5
# 모의 실행 원장(Phase 4) — 위와 같은 Postgres 인스턴스를 그대로 재사용.
PAPER_STARTING_CASH=100000.0
# 백테스트(historical replay) 전용 기준자본(USD). 위 PAPER_STARTING_CASH는 실행원장
# 폴백/모의 시작자본이고, 백테스트는 이 값만 씀 — 배포(실계좌) 환경에서 폴백을 실제
# 예수금 수준으로 낮춰도 백테스트 사이징이 망가지지 않도록 2026-08-31에 분리함.
BACKTEST_STARTING_CASH=100000.0

# === 매매허용목록 ===
# TRADE_ALLOWLIST_DOMESTIC / TRADE_ALLOWLIST_OVERSEAS 환경변수는 제거됨(2026-08-06).
#
# 이 목록 자체는 없어진 게 아니라 그대로 살아 있고, 여전히 매매 허용 게이트임
# (app/execution/kis_bridge.py — 목록에 없는 종목은 BLOCKED). 없어진 건 "최초 1회
# 시드값"으로서의 환경변수뿐임.
#
# 실제 출처는 Postgres(trade_allowlist_state)이고 (user_id, account_mode)별로
# 분리돼 있음. 부팅할 때마다 app.web.trade_allowlist_store.load()가 환경변수 값을
# 덮어쓰므로, 한 번이라도 돌아간 배포에서는 이 환경변수가 이미 아무 효과가 없었음.
# 종목은 대시보드에서 추가하거나 AI가 BUY 판단을 낼 때 자동 추가됨.
#
# ⚠️ 새 account_mode 스코프(예: real)는 빈 목록으로 시작한다
#    (app/config.py의 SCOPED_LIST_KEYS) — 전환 후 대시보드에서 직접 추가할 것.

# === 실행 모드 ===
# 실행 모드(manual/semi_auto/full_auto) — app/config.py의 ExecutionMode 참고.
# ⚠️ DB 오버라이드(runtime_settings 테이블)가 있으면 그쪽이 이긴다. 오버라이드는
#    (user_id, account_mode) 스코프별로 저장되므로, 새 스코프에는 이 env 값이 적용된다.
EXECUTION_MODE=semi_auto

# === 자동매매 루프 (전부 서로 얽혀서 함께 튜닝해야 함) ===
# 자동매매 루프 on/off — app/config.py의 auto_trade_enabled 참고.
AUTO_TRADE_ENABLED=true
# 사이클 주기(분) — 아래 MAX_TICKERS/동시분석 수와 함께 조정할 것.
AUTO_TRADE_INTERVAL_MINUTES=10

# 후보 풀 크기(국내/해외 각각) — 시장마다 두 소스(거래량순위 + 시가총액순위)를 합쳐서
# 후보 풀을 구성함(app/live/auto_trade_loop.py). 거래량순위:
AUTO_TRADE_SCAN_COUNT_DOMESTIC=30
AUTO_TRADE_SCAN_COUNT_OVERSEAS=30
# 시가총액순위:
AUTO_TRADE_SCAN_COUNT_DOMESTIC_MARKET_CAP=30
AUTO_TRADE_SCAN_COUNT_OVERSEAS_MARKET_CAP=30

# 위 후보 풀 중 실제로 LLM 분석(4애널리스트+디베이트+PM)까지 가는 종목 수 상한
# (시장별) — 사이클 시간에 직결되므로 위 INTERVAL_MINUTES와 함께 튜닝할 것.
AUTO_TRADE_MAX_TICKERS_DOMESTIC=4
AUTO_TRADE_MAX_TICKERS_OVERSEAS=4

# 후보종목 동시분석 상한 — LLM 왕복지연이 대부분이라 어느 정도 동시 진행 이득이 있음.
# 1로 설정하면 완전 순차 처리.
# ⚠️ 2026-08-12 서버 다운 이력 — 2 이상으로 올리지 말 것.
AUTO_TRADE_MAX_CONCURRENT_ANALYSES=2

# 1주도 못 사는 종목은 랭킹 전에 걸러냄(2026-09-01 audit #6) — app/config.py의
# auto_trade_skip_unexecutable_candidates 참고. 기본 true.
# AUTO_TRADE_SKIP_UNEXECUTABLE_CANDIDATES=true
# ATR(14)이 없는 종목은 신규 진입만 이번 사이클 거부(2026-09-02, id=1169,
# 950260.KS) — app/config.py의 auto_trade_require_atr_for_new_entry 참고.
# 이미 보유 중인 포지션은 영향 없음. 기본 true.
# AUTO_TRADE_REQUIRE_ATR_FOR_NEW_ENTRY=true

# === 리스크/손실한도 ===
# 일일 최대 손실 한도(%) — 국내/해외 계좌 각각 독립 추적하되 기준(%)은 공유.
# 넘기면 그 시장의 당일 신규 매수만 차단(매도는 항상 허용).
KIS_DAILY_MAX_LOSS_PCT=0.05

# === KIS 모드 선택 ===
# paper 또는 real. 반드시 paper로 시작할 것 — real로 바꾸는 순간부터 이 앱이
# 내는 모든 주문은 실제 돈이 움직이는 실거래가 됨. 절대 기본값이 real이면 안 됨.
#
# ⚠️ 함정(2026-08-31 확인): 이 값이 활성 모드를 "직접" 결정하지는 않는다.
# 실제 활성 모드는 app/account_mode.py::resolve_preference()가 정하며 순서는
#   ① DB users.preferred_account_mode 에 값이 있고 그 모드에 자격증명이 있으면 그것
#   ② 없으면 ("paper","real") 순으로 자격증명이 있는 첫 모드
# 즉 real 키만 채우고 paper 키를 비우면 여기가 paper여도 실계좌로 동작한다.
# 모드를 확정하려면 PUT /api/account-mode 로 preferred_account_mode를 명시할 것.
KIS_ACCOUNT_MODE=paper

# === KIS 자격증명 ===
# 2026-08-06까지는 사용자별로 암호화되어 Postgres에 저장됐으나, 단일 계좌
# 하나만 쓰기로 결정되면서(docs/single-user-rollback-guide.md) 다시
# env로 돌아옴. 실제 값은 여기에 채우지 말 것 — 로컬은 .env.local(모의만),
# 배포는 Jenkins Credentials가 주입함(가이드 §3).
#
# paper/real은 서로 독립 — 하나만 채워도 됨. 모드 간 폴백은 절대 없음.
# app_key/app_secret/account_8 세 개가 모두 있어야 "configured"로 인식됨
# (app/config.py::configured_kis_modes — 빈 문자열은 미설정으로 처리).
# account_prod는 비밀이 아님(종합계좌는 거의 항상 "01"), hts_id는 선택
# (없으면 체결통보 실시간 구독만 비활성화).
KIS_APP_KEY_REAL=
KIS_APP_SECRET_REAL=
KIS_ACCOUNT_8_REAL=
KIS_ACCOUNT_PROD_REAL=01
KIS_HTS_ID_REAL=
KIS_APP_KEY_PAPER=
KIS_APP_SECRET_PAPER=
KIS_ACCOUNT_8_PAPER=
KIS_ACCOUNT_PROD_PAPER=01
KIS_HTS_ID_PAPER=

# 공개 엔드포인트만 여기 남음 — 비밀이 아니며, 버전관리해 두어야 개인이
# 잘못 입력해도 주문이 엉뚱한 호스트로 가지 않음.
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443

# OAuth 접근토큰 캐시 디렉터리. 배포 시에는 pipeline.sh가 Docker named volume을
# /var/cache/kis에 마운트하며 이 값을 주입함 — env 파일에서 설정하지 말 것.
# 미설정 시 app/ 패키지 디렉터리(로컬/테스트 기본값, 동작 불변).
# The deploy value is supplied by pipeline.sh (Docker volume mount), not here.
# KIS_TOKEN_CACHE_DIR=

# === 로그인/세션은 없음 (2026-08-07 단일계좌 전환) ===
# CREDENTIAL_ENCRYPTION_KEY / AUTH_REQUIRED / SESSION_COOKIE_NAME /
# SESSION_TTL_HOURS는 모두 제거됨 — 이 앱에는 애플리케이션 수준 인증이 없음.
# 접근 통제는 DASHBOARD_HOST를 루프백에 두고 SSH 터널로만 접속하는 것이 전부
# (app/config.py::_refuse_non_loopback_bind가 루프백이 아니면 무조건 부팅을
# 거부함 — 켜고 끌 수 있는 스위치가 없음).
# 자세한 배경은 docs/single-user-rollback-guide.md §0/§1 참조.

# === 실행 게이트 (app/execution/kis_bridge.py) ===
# 기본값이 전부 "안전한 쪽"이라, 실제 주문이 나가려면 아래 두 개를 명시적으로
# 바꿔야 함 (마스터 스위치 ON + dry-run 해제).
# 두 값 모두 런타임 변경 불가 — 바꾸려면 재배포해야 함(의도적으로 API에 없음,
# app/execution/risk_rules.py 참고).
KIS_EXECUTION_ENABLED=false
KIS_EXECUTION_DRY_RUN=true

# 1회 주문 추정금액 상한 — paper/real 분리 (2026-08-05). *_PAPER 값은 이 모의
# 계좌 자체의 잔고 이력 기준으로 튜닝된 값이라 실전계좌 규모와 무관함.
# *_REAL은 아래 "실전 한도" 절 참고.
KIS_MAX_ORDER_KRW_PAPER=5500000
KIS_MAX_ORDER_USD_PAPER=40000

# 서킷브레이커 unknown-state 처리 — 기본 false = fail-closed: 서킷브레이커
# 상태를 모르면(코드값 매핑 미확보, WS 피드 미연결 등) 국내 주문을 막음.
KIS_CB_FAIL_OPEN_WHEN_UNKNOWN=false

# === 조건부 자동매매 리스크 규칙 (사용자 설정형) ===
# 각 규칙은 on/off 플래그 + 값 쌍. 기본 전부 off라, 켜기 전엔 동작 무변화.
# LLM 판단과 무관하게 kis_bridge에서 코드레벨로 최종 차단됨.
# 종목당 최대 포지션 비중(%): 매수가 이 비중을 넘기면 차단.
# ⚠️ 국내(KRW) 전용 — 해외는 FX 정규화 미구현이라 무시됨(kis_bridge.py:446).
KIS_MAX_POSITION_PCT_ENABLED=false
KIS_MAX_POSITION_PCT=20
# 승인 임계금액 — 이 금액 이상 주문은 명시적 승인(approved) 필요.
# 실전 자동매매에서 유일한 금액 기반 브레이크.
KIS_APPROVAL_REQUIRED_ENABLED=false
KIS_APPROVAL_THRESHOLD_KRW_PAPER=3000000
KIS_APPROVAL_THRESHOLD_USD_PAPER=2000

# === 실전(real) 한도 4종 — real 전환 시 필수 ===
# ⚠️ 2026-08-31 수정: 예전엔 이 네 줄이 `KIS_MAX_ORDER_KRW_REAL=` 처럼 빈 값으로
# 있었고 주석은 "0으로 둔다"고 설명했는데, 둘 다 틀렸다. 이 필드들은
# `float | None`(app/config.py:1052,1070,1122,1124)이라 **빈 문자열은 None이 아니라
# 파싱 에러**가 되어 부팅이 거부된다(실측 확인). None이 되려면 줄 자체가 없어야 한다.
#
# 미설정(None) = fail-CLOSED: KIS_ACCOUNT_MODE=real 이면 부팅 자체가 거부되고
# (app/config.py:1571-1599), 설정 전까지는 어떤 주문도 통과하지 못한다. '무제한'이 아님.
# 계좌 규모가 사람마다 달라 전역 기본값이 무의미하므로 직접 정할 것.
# 교차검증 있음: 임계값 < 상한 (app/execution/risk_rules.py::_validate_cross_field).
#
# real로 전환할 때 아래 네 줄의 주석을 풀고 값을 채울 것:
# KIS_MAX_ORDER_KRW_REAL=
# KIS_MAX_ORDER_USD_REAL=
# KIS_APPROVAL_THRESHOLD_KRW_REAL=
# KIS_APPROVAL_THRESHOLD_USD_REAL=

# === 주문한도 절대 상한 ===
# 사용자가 대시보드에서 자기 주문한도를 올릴 수 있는 절대 상한(2026-08-06 결정).
# USD는 원화 기준(~1,425.78 KRW/USD) 환산 후 반올림. 환율이 크게 움직이면 재계산할 것.
# 이 둘도 `float | None`이라 빈 값을 쓰면 안 됨 — 미설정이면 '상한 없음'이므로
# 운영 배포에서는 반드시 값을 넣을 것.
KIS_MAX_ORDER_KRW_CEILING=100000000
KIS_MAX_ORDER_USD_CEILING=70000
